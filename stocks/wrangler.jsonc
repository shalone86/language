{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "skit-stocks",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  // Progress saved under a save code, so it survives a phone that clears browser data.
  "kv_namespaces": [{ "binding": "PROGRESS", "id": "c5bd68ca7f0040fd81640bdd1e493d97" }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "stocks.shalonely.com", "custom_domain": true }]
  // Optional: require a passcode for the API:  npx wrangler secret put APP_PASSCODE
}
